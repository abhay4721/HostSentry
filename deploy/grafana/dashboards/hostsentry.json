    {"id":4,"type":"timeseries","title":"Incidents by status","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"hostsentry_incidents_total","legendFormat":"{{status}}","refId":"A"}],"datasource":{"type":"prometheus","uid":"hostsentry-prometheus"}},
