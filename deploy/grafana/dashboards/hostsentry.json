    {"id":8,"type":"timeseries","title":"Memory used","gridPos":{"h":8,"w":12,"x":0,"y":32},"targets":[{"expr":"hostsentry_agent_memory_usage_bytes","legendFormat":"{{host_id}}","refId":"A"}],"datasource":{"type":"prometheus","uid":"hostsentry-prometheus"}},
