# setup-central.sh generates random secrets and the local CA.
POSTGRES_PASSWORD=replace-with-random-hex
HOSTSENTRY_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
HOSTSENTRY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-32-byte-password
HOSTSENTRY_METRICS_TOKEN=replace-with-64-random-hex
HOSTSENTRY_HEALTH_WEIGHTS={"cpu":20,"memory":20,"disk":20,"services":25,"network":10,"agent":5}
HOSTSENTRY_RECOVERY_ENABLED=false
HOSTSENTRY_RECOVERY_DRY_RUN=true
HOSTSENTRY_ANOMALY_ENABLED=true
HOSTSENTRY_ANOMALY_MIN_SAMPLES=20
HOSTSENTRY_ANOMALY_SIGMA=3
HOSTSENTRY_NOTIFY_SEVERITIES=critical,warning
HOSTSENTRY_NOTIFY_TYPES=
HOSTSENTRY_TELEGRAM_BOT_TOKEN=
HOSTSENTRY_TELEGRAM_CHAT_ID=
HOSTSENTRY_GITHUB_TOKEN=
HOSTSENTRY_GITHUB_REPOSITORY=
HOSTSENTRY_GITHUB_LABELS=
HOSTSENTRY_SMTP_ADDRESS=
HOSTSENTRY_SMTP_USERNAME=
HOSTSENTRY_SMTP_PASSWORD=
HOSTSENTRY_SMTP_FROM=
HOSTSENTRY_SMTP_TO=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-hex
HOSTSENTRY_CONTAINER_UID=1000
HOSTSENTRY_CONTAINER_GID=1000

# Local-only defaults. Set HOSTSENTRY_API_BIND to the server's LAN address for agents.
HOSTSENTRY_API_BIND=127.0.0.1
HOSTSENTRY_UI_BIND=127.0.0.1
HOSTSENTRY_PROMETHEUS_URL=http://prometheus:9090
